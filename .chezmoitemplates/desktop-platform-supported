{{- if eq .chezmoi.os "darwin" -}}
true
{{- else if eq .chezmoi.os "linux" -}}
{{- $id := get .chezmoi.osRelease "id" | default "" -}}
{{- $version := get .chezmoi.osRelease "versionID" | default "" -}}
{{- $kernel := get .chezmoi.kernel "osrelease" | default "" -}}
{{- $isArch := eq (includeTemplate "system-package-manager" .) "pacman" -}}
{{- $isUbuntuDesktop := and (eq $id "ubuntu") (ne $version "")
    (semverCompare ">=26.4.0" (printf "%s.0" $version)) -}}
{{- if and (not (contains "microsoft" (lower $kernel))) (or $isArch $isUbuntuDesktop) -}}
true
{{- end -}}
{{- end -}}

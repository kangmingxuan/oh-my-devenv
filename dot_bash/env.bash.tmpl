# ~/.bash/env.bash
# Shared environment initialization for both login and interactive shells.
# Idempotent and safe to source multiple times.

# Guard against multiple sourcing.
if [[ -n "${__BASH_ENV_DONE-}" ]]; then
  return 0
fi
__BASH_ENV_DONE=1

# Resolve XDG directories before reading any local configuration.
# shellcheck disable=SC1091
source "$HOME/.local/share/oh-my-devenv/xdg.sh"
oh_my_devenv_setup_xdg_dirs

# --- PATH Helpers ---
# Move existing directories to the front of PATH in argument order. Empty and
# missing directories are skipped; each moved directory appears exactly once.
# Directories are compared literally, never as patterns.
path_reorder_front() {
  local dir front="" rest=":$PATH:"
  for dir in "$@"; do
    [[ -n "$dir" && -d "$dir" ]] || continue
    [[ ":$front:" != *":$dir:"* ]] || continue
    front="${front:+$front:}$dir"
    # Repeat because adjacent duplicates share the separating colon.
    while [[ "$rest" == *":$dir:"* ]]; do
      rest="${rest//":$dir:"/:}"
    done
  done
  [[ -n "$front" ]] || return 0
  # rest is ":" when nothing remains; otherwise its leading colon separates
  # front from the remaining entries, including a sole empty (cwd) entry.
  rest="${rest%:}"
  PATH="$front$rest"
}

# --- Debian Command Names ---
if ! command -v fd >/dev/null 2>&1 && command -v fdfind >/dev/null 2>&1; then
  fd() {
    command fdfind "$@"
  }
fi

if ! command -v bat >/dev/null 2>&1 && command -v batcat >/dev/null 2>&1; then
  bat() {
    command batcat "$@"
  }
fi

# --- Tool Initialization ---
{{- if eq .chezmoi.os "darwin" }}

# Homebrew shellenv (sets PATH/MANPATH/INFOPATH...)
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
fi
{{- end }}

# Go
# GOPATH is the Go module cache and default install root; GOBIN is the directory
# placed on PATH for `go install` binaries.
export GOPATH="${GOPATH:-$HOME/go}"
export GOBIN="${GOBIN:-$GOPATH/bin}"

# Mise shims keep tool resolution stable when hooks are not active.
export MISE_SHIMS_DIR="${MISE_SHIMS_DIR:-$HOME/.local/share/mise/shims}"

# --- PATH Ordering ---
path_reorder_front \
  "$MISE_SHIMS_DIR" \
  "$HOME/bin" \
  "$HOME/.local/bin" \
  "$GOBIN" \
  "${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/bin}" \
  "${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/sbin}"

export PATH

# Other environment variables.
# Pick a `bat` theme that is bundled with every recent `bat` release so new
# machines never see an "unknown theme" warning on first run. Override in
# $XDG_CONFIG_HOME/oh-my-devenv/env.sh to use a different theme.
export BAT_THEME='TwoDark'

# Load persistent non-secret shell environment variables if present.
oh_my_devenv_source_env_file "$XDG_CONFIG_HOME/oh-my-devenv/env.sh"

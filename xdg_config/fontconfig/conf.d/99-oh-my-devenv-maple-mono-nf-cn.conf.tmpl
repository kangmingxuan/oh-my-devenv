{{- $desktopBaseline := false -}}
{{- if hasKey . "desktopBaseline" -}}
{{- $desktopBaseline = .desktopBaseline -}}
{{- end -}}
{{- $desktopPlatformSupported := false -}}
{{- if hasKey . "desktopPlatformSupported" -}}
{{- $desktopPlatformSupported = .desktopPlatformSupported -}}
{{- end -}}
{{- $enableMapleMonoAlias := and (eq .chezmoi.os "linux") $desktopBaseline $desktopPlatformSupported
    (eq (get .chezmoi.osRelease "id") "ubuntu") -}}
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<fontconfig>{{ if $enableMapleMonoAlias }}
  <description>Ubuntu Ghostty font discovery workaround for {{ .desktopFontFamily }}</description>

  <!--
    On Ubuntu, Ghostty has been observed falling back to the distribution's
    monospace font despite its explicit font-family setting. Restrict this
    workaround to Ghostty; other applications retain their font preferences.
  -->
  <match target="pattern">
    <test name="prgname" compare="eq">
      <string>ghostty</string>
    </test>
    <test name="family" qual="any" compare="eq">
      <string>monospace</string>
    </test>
    <edit name="family" mode="prepend" binding="strong">
      <string>{{ .desktopFontFamily }}</string>
    </edit>
  </match>
{{- else }}
  <!-- Intentionally inactive outside the supported Ubuntu desktop baseline. -->
{{- end }}
</fontconfig>

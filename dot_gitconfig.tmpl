{{- $xdgConfigHome := env "XDG_CONFIG_HOME" -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $xdgConfigHome = joinPath .chezmoi.destDir ".config" -}}
{{- else if not (hasPrefix "/" $xdgConfigHome) -}}
{{-   $xdgConfigHome = joinPath .chezmoi.homeDir ".config" -}}
{{- end -}}
[user]
    name = {{ .name | quote }}
    email = {{ .email | quote }}
{{- if eq .chezmoi.os "windows" }}

[core]
    autocrlf = input
    longpaths = true
{{- end }}

[include]
    path = {{ joinPath $xdgConfigHome "oh-my-devenv/git/config" | quote }}

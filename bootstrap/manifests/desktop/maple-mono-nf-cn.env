# Desktop font baseline. Fixed scalar assignments only; loaded through
# desktop_font_manifest_load in bootstrap/scripts/common.sh.
#
# The family and its required faces are shared by the Linux installer, the
# environment check on every desktop platform, and the managed Ghostty and
# Fontconfig templates (xdg-config.sh passes the family as template data).
MAPLE_MONO_FAMILY="Maple Mono NF CN"
MAPLE_MONO_POSTSCRIPT_NAMES="MapleMono-NF-CN-Regular MapleMono-NF-CN-Bold MapleMono-NF-CN-Italic MapleMono-NF-CN-BoldItalic"

# Pinned upstream release for Linux user-local installation. macOS installs the
# same family through the desktop Brewfile cask.
MAPLE_MONO_VERSION=7.9
MAPLE_MONO_ARCHIVE=MapleMono-NF-CN-unhinted.zip
MAPLE_MONO_URL=https://github.com/subframe7536/maple-font/releases/download/v7.9/MapleMono-NF-CN-unhinted.zip
MAPLE_MONO_SHA256=ab88522932cf4015dffeaef6dedc59a22a5fefecdcc6e583d9fcd997da5b7cac

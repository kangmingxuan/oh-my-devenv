# Internal mirror endpoints for DOTFILES_MIRROR_MODE=internal.
#
# Two whitespace-separated columns:
#
#   <ENV_VAR_NAME> <value>
#
# dotfiles_apply_mirror_env exports each row in internal mode. A caller-provided
# DOTFILES_<ENV_VAR_NAME> override always wins. A <placeholder-...> value is
# inert: the key stays unset until the override is provided, so this public
# manifest never carries a private hostname. External mode ignores this file
# and leaves the caller environment untouched, so downstream tools keep their
# own defaults.
#
# Lines starting with `#` and blank lines are ignored. Add a consumer by adding
# a row here and reading the target variable in the corresponding install
# script after it calls dotfiles_apply_mirror_env.

GOPROXY                     <placeholder-internal-goproxy>
UV_INDEX_URL                <placeholder-internal-pypi-simple>
HOMEBREW_API_DOMAIN         <placeholder-internal-brew-api>
HOMEBREW_BOTTLE_DOMAIN      <placeholder-internal-brew-bottle>
DOTFILES_MISE_INSTALL_URL   <placeholder-internal-mise-installer>
DOTFILES_OH_MY_ZSH_GIT_URL  <placeholder-internal-oh-my-zsh-git>

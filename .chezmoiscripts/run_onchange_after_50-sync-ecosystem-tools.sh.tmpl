{{- $bootstrapDir := joinPath .chezmoi.sourceDir "bootstrap" -}}
#!/bin/bash
# go-tools.txt hash: {{ include "bootstrap/manifests/ecosystem/go-tools.txt" | sha256sum }}
# uv-tools.txt hash: {{ include "bootstrap/manifests/ecosystem/uv-tools.txt" | sha256sum }}
# Go installer hash: {{ include "bootstrap/scripts/install-go-tools.sh" | sha256sum }}
# uv installer hash: {{ include "bootstrap/scripts/install-uv-tools.sh" | sha256sum }}
# uv tools run on the mise-managed Python, so a Python change must rebuild them.
# mise config hash: {{ include "xdg_config/mise/config.toml.tmpl" | sha256sum }}

set -euo pipefail

bootstrap_dir='{{ $bootstrapDir }}'
scripts_dir="$bootstrap_dir/scripts"
manifests_dir="$bootstrap_dir/manifests"

source "$scripts_dir/common.sh"
install_error_trap "$0"

setup_go_env

export_tool_path "$GOBIN"

log_step "🔄" "Syncing ecosystem tools..."

bash "$scripts_dir/install-go-tools.sh" "$manifests_dir/ecosystem/go-tools.txt"
bash "$scripts_dir/install-uv-tools.sh" "$manifests_dir/ecosystem/uv-tools.txt"

log_step "✅" "Ecosystem tools synced."

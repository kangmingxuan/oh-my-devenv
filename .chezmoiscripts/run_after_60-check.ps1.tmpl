Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

. {{ includeTemplate "powershell-literal" (joinPath .chezmoi.sourceDir "bootstrap/windows/common.ps1") }}

trap {
    Write-BootstrapFailure $_
    exit (Get-BootstrapExitCode $_)
}

if (-not $IsWindows) {
    throw 'This hook requires native Windows.'
}

. {{ includeTemplate "powershell-literal" (joinPath .chezmoi.sourceDir "bootstrap/windows/user-path.ps1") }}

$destination = {{ includeTemplate "powershell-literal" .chezmoi.destDir }}
$homeDirectory = {{ includeTemplate "powershell-literal" .chezmoi.homeDir }}
$profilePath = Get-HookProfilePath -Destination $destination -HomeDirectory $homeDirectory
$pathTarget = Get-HookUserPathTarget -Destination $destination -HomeDirectory $homeDirectory
& {{ includeTemplate "powershell-literal" (joinPath .chezmoi.sourceDir "bootstrap/windows/check.ps1") }} `
    -Destination $destination -ProfilePath $profilePath -RegistryPath $pathTarget.RegistryPath `
    -ProbeFixtureBin $env:OH_MY_DEVENV_WINDOWS_PROBE_BIN `
    -DesktopBaseline:${{ if (index . "desktopBaseline") }}true{{ else }}false{{ end }}
if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

Write-LogNext 'Open a new PowerShell session to load the managed profile and Path.'
Write-LogNext 'New to this baseline? Read docs/01-onboarding.md.'
Write-LogNext 'For machine-only settings or restricted networks, see docs/local-overlay-examples/.'
Write-LogNext 'If something is wrong, report it with the repository bug-report template.'

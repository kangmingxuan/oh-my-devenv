# winget-packages.json: {{ include "bootstrap/manifests/system/winget-packages.json" | sha256sum }}
# system-packages.ps1: {{ include "bootstrap/windows/system-packages.ps1" | sha256sum }}
# common.ps1: {{ include "bootstrap/windows/common.ps1" | sha256sum }}
# environment.ps1: {{ include "dot_config/oh-my-devenv/powershell/environment.ps1" | sha256sum }}

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

. {{ includeTemplate "powershell-literal" (joinPath .chezmoi.sourceDir "bootstrap/windows/common.ps1") }}

trap {
    Write-BootstrapFailure $_
    exit (Get-BootstrapExitCode $_)
}

if (-not $IsWindows) {
    throw 'This hook requires native Windows.'
}

. {{ includeTemplate "powershell-literal" (joinPath .chezmoi.sourceDir "bootstrap/windows/system-packages.ps1") }}

Write-LogPhase 'Installing system packages via WinGet...'
Update-HookPath
Install-WinGetPackage -ManifestPath {{ includeTemplate "powershell-literal" (joinPath .chezmoi.sourceDir "bootstrap/manifests/system/winget-packages.json") }}
Write-LogPhaseDone

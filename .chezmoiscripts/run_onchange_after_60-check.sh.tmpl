{{- $packageManager := includeTemplate "system-package-manager" . -}}
{{- $desktopBaseline := false -}}
{{- if hasKey . "desktopBaseline" -}}
{{- $desktopBaseline = .desktopBaseline -}}
{{- end -}}
{{- $isSupportedDesktop := eq (includeTemplate "desktop-platform-supported" .) "true" -}}
#!/bin/bash
{{ if eq $packageManager "pacman" -}}
# pacman-packages.txt hash: {{ include "bootstrap/manifests/system/pacman-packages.txt" | sha256sum }}
{{ else if eq $packageManager "apt" -}}
# apt-packages.txt hash: {{ include "bootstrap/manifests/system/apt-packages.txt" | sha256sum }}
{{ else if eq .chezmoi.os "darwin" -}}
# Brewfile hash: {{ include "bootstrap/manifests/system/Brewfile" | sha256sum }}
{{ end -}}
{{ if and $desktopBaseline $isSupportedDesktop -}}
# Ghostty config hash: {{ include "xdg_config/ghostty/config.ghostty.tmpl" | sha256sum }}
# Maple Mono manifest hash: {{ include "bootstrap/manifests/desktop/maple-mono-nf-cn.env" | sha256sum }}
{{ if eq .chezmoi.os "darwin" -}}
# Desktop Brewfile hash: {{ include "bootstrap/manifests/desktop/Brewfile" | sha256sum }}
{{ else -}}
{{ if eq $packageManager "pacman" -}}
# Desktop pacman manifest hash: {{ include "bootstrap/manifests/desktop/pacman-packages.txt" | sha256sum }}
{{ else -}}
# Desktop apt manifest hash: {{ include "bootstrap/manifests/desktop/apt-packages.txt" | sha256sum }}
{{ end -}}
# Maple Mono Fontconfig hash: {{ include "xdg_config/fontconfig/conf.d/99-oh-my-devenv-maple-mono-nf-cn.conf.tmpl" | sha256sum }}
{{ end -}}
{{ end -}}
# go-tools.txt hash: {{ include "bootstrap/manifests/ecosystem/go-tools.txt" | sha256sum }}
# uv-tools.txt hash: {{ include "bootstrap/manifests/ecosystem/uv-tools.txt" | sha256sum }}
# oh-my-zsh-plugins.txt hash: {{ include "bootstrap/manifests/shell/oh-my-zsh-plugins.txt" | sha256sum }}
# completions.txt hash: {{ include "bootstrap/manifests/shell/completions.txt" | sha256sum }}
# mise config hash: {{ include "xdg_config/mise/config.toml.tmpl" | sha256sum }}

set -euo pipefail

bootstrap_dir='{{ joinPath .chezmoi.sourceDir "bootstrap" }}'
scripts_dir="$bootstrap_dir/scripts"
manifests_dir="$bootstrap_dir/manifests"

source "$scripts_dir/common.sh"
install_error_trap "$0"
source "$scripts_dir/go-env.sh"

setup_go_env

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$GOBIN:$PATH"

log_step "🔎" "Running environment checks..."

errors=0
ghostty_bin=""

check_cmd() {
  if command -v "$1" >/dev/null 2>&1; then
    log_check_ok "$1"
  else
    log_check_missing "$1"
    errors=$((errors + 1))
  fi
}

check_path() {
  local path="$1"
  local name="$2"

  if [[ -e "$path" ]]; then
    log_check_ok "$name"
  else
    log_check_missing "$name"
    errors=$((errors + 1))
  fi
}

# Every package declared in an apt manifest must be installed according to dpkg.
check_apt_packages() {
  local manifest="$1"
  local entries=""
  local package=""
  local status=""

  if ! entries="$(manifest_entries "$manifest")"; then
    errors=$((errors + 1))
    return 0
  fi

  while IFS= read -r package; do
    if [[ -z "$package" ]]; then
      continue
    fi
    status="$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)"
    if [[ "$status" == *"install ok installed"* ]]; then
      log_check_ok "$package"
    else
      log_check_missing "$package"
      errors=$((errors + 1))
    fi
  done <<<"$entries"
}

check_pacman_packages() {
  local manifest="$1" entries="" package=""
  if ! entries="$(manifest_entries "$manifest")"; then
    errors=$((errors + 1))
    return 0
  fi
  while read -r package; do
    [[ -n "$package" ]] || continue
    if pacman -Q "$package" >/dev/null 2>&1; then
      log_check_ok "$package"
    else
      log_check_missing "$package"
      errors=$((errors + 1))
    fi
  done <<<"$entries"
}

# Homebrew validates a Brewfile natively; presence is checked, upgrades are not.
check_brewfile() {
  local brewfile="$1"
  local brew_bin=""
  local output=""

  if ! brew_bin="$(brew_command)"; then
    errors=$((errors + 1))
    return 0
  fi

  if output="$("$brew_bin" bundle check --file="$brewfile" --no-upgrade --verbose 2>&1)"; then
    log_check_ok "${brewfile#"$manifests_dir/"}"
  else
    log_warning "Homebrew bundle is not satisfied: $brewfile"
    printf '%s\n' "$output" >&2
    errors=$((errors + 1))
  fi
}

# mise reports which tools its configuration declares but has not installed.
check_mise_toolchain() {
  local missing=""
  local tool=""
  local version=""

  if ! command -v mise >/dev/null 2>&1; then
    log_check_missing "mise"
    errors=$((errors + 1))
    return 0
  fi
  log_check_ok "mise"
  check_path "$XDG_CONFIG_HOME/mise/config.toml" "mise config"

  # Only stdout is parsed; mise warnings stay visible on stderr without being
  # mistaken for missing tools.
  if ! missing="$(mise ls --current --missing --no-header)"; then
    log_warning "mise could not inspect the configured toolchain"
    errors=$((errors + 1))
    return 0
  fi

  if [[ -n "$missing" ]]; then
    while read -r tool version _; do
      if [[ -n "$tool" ]]; then
        log_check_missing "$tool $version"
      fi
    done <<<"$missing"
    errors=$((errors + 1))
    return 0
  fi

  log_check_ok "mise toolchain"
}

resolve_ghostty_bin() {
  local candidate=""

  if command -v ghostty >/dev/null 2>&1; then
    command -v ghostty
    return 0
  fi

  for candidate in \
    "/Applications/Ghostty.app/Contents/MacOS/Ghostty" \
    "$HOME/Applications/Ghostty.app/Contents/MacOS/Ghostty" \
    "/Applications/Ghostty.app/Contents/MacOS/ghostty" \
    "$HOME/Applications/Ghostty.app/Contents/MacOS/ghostty"; do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

check_ghostty_config() {
  local executable="$1"

  if [[ -z "$executable" ]]; then
    log_check_missing "ghostty"
    errors=$((errors + 1))
    return 0
  fi

  log_check_ok "ghostty"
  if "$executable" +validate-config >/dev/null 2>&1; then
    log_check_ok "ghostty config"
  else
    log_warning "Ghostty could not load the managed configuration."
    errors=$((errors + 1))
  fi
}

# Linux: verify the declared faces are available. Ghostty selects its font in
# its own configuration; the system monospace preference belongs to the user.
check_desktop_font_fontconfig() {
  local installed_names=""
  local postscript_name=""

  if ! command -v fc-list >/dev/null 2>&1; then
    log_check_missing "fontconfig"
    errors=$((errors + 1))
    return 0
  fi

  installed_names="$(fc-list -f '%{postscriptname}\n' ":family=$MAPLE_MONO_FAMILY")"
  for postscript_name in $MAPLE_MONO_POSTSCRIPT_NAMES; do
    if ! grep -Fxq "$postscript_name" <<<"$installed_names"; then
      log_check_missing "$postscript_name"
      errors=$((errors + 1))
      return 0
    fi
  done

  log_check_ok "$MAPLE_MONO_FAMILY"
}

# macOS: the Homebrew cask installs one file per declared face in the user font directory.
check_desktop_font_macos() {
  local font_dir="$HOME/Library/Fonts"
  local postscript_name=""

  for postscript_name in $MAPLE_MONO_POSTSCRIPT_NAMES; do
    if [[ ! -f "$font_dir/$postscript_name.ttf" ]]; then
      log_check_missing "$postscript_name.ttf"
      errors=$((errors + 1))
      return 0
    fi
  done

  log_check_ok "$MAPLE_MONO_FAMILY"
}

check_manifest_cmds() {
  local manifest="$1"
  local command_name_parser="$2"
  local entries=""
  local tool_spec=""
  local command_name=""

  if ! entries="$(manifest_entries "$manifest")"; then
    errors=$((errors + 1))
    return 0
  fi

  while IFS= read -r tool_spec; do
    if [[ -z "$tool_spec" ]]; then
      continue
    fi
    command_name="$($command_name_parser "$tool_spec")"

    if [[ -z "$command_name" ]]; then
      log_warning "Skipping invalid manifest entry in $manifest: $tool_spec"
      errors=$((errors + 1))
      continue
    fi

    check_cmd "$command_name"
  done <<<"$entries"
}

check_oh_my_zsh_plugins() {
  local manifest="$1"
  local zsh_custom_dir="$2"
  local entries=""
  local plugin_entry=""
  local plugin_repo=""
  local plugin_path=""
  local extra_field=""

  if ! entries="$(manifest_entries "$manifest")"; then
    errors=$((errors + 1))
    return 0
  fi

  while IFS= read -r plugin_entry; do
    if [[ -z "$plugin_entry" ]]; then
      continue
    fi
    read -r plugin_repo plugin_path extra_field <<<"$plugin_entry"

    if [[ -z "$plugin_repo" || -z "$plugin_path" || -n "$extra_field" ]]; then
      log_warning "Skipping invalid oh-my-zsh plugin entry in $manifest: $plugin_entry"
      errors=$((errors + 1))
      continue
    fi

    check_path "$zsh_custom_dir/$plugin_path" "${plugin_path##*/}"
  done <<<"$entries"
}

detect_shell_rc_file() {
  local shell_name

  shell_name="$(basename "${SHELL:-}")"

  case "$shell_name" in
    zsh)
      printf '%s\n' "$HOME/.zshrc"
      ;;
    bash)
      printf '%s\n' "$HOME/.bashrc"
      ;;
    *)
      return 1
      ;;
  esac
}

# System packages
{{ if eq $packageManager "pacman" -}}
check_pacman_packages "$manifests_dir/system/pacman-packages.txt"
{{ else if eq $packageManager "apt" -}}
check_apt_packages "$manifests_dir/system/apt-packages.txt"
{{ else if eq .chezmoi.os "darwin" -}}
check_brewfile "$manifests_dir/system/Brewfile"
{{ end }}
# Runtimes and binary-distributed tools
check_mise_toolchain

# Ecosystem tools
check_manifest_cmds "$manifests_dir/ecosystem/go-tools.txt" go_tool_binary_name
check_manifest_cmds "$manifests_dir/ecosystem/uv-tools.txt" uv_tool_binary_name

# Shell assets
check_path "$HOME/.oh-my-zsh/oh-my-zsh.sh" "oh-my-zsh"
check_oh_my_zsh_plugins "$manifests_dir/shell/oh-my-zsh-plugins.txt" "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"
if ! bash "$scripts_dir/install-shell-completions.sh" check '{{ .chezmoi.os }}' "$manifests_dir/shell/completions.txt"; then
  errors=$((errors + 1))
fi

{{ if and $desktopBaseline $isSupportedDesktop -}}
# Desktop baseline
desktop_font_manifest_load "$manifests_dir/desktop/maple-mono-nf-cn.env"
{{ if eq .chezmoi.os "darwin" -}}
check_brewfile "$manifests_dir/desktop/Brewfile"
{{ else if eq $packageManager "pacman" -}}
check_pacman_packages "$manifests_dir/desktop/pacman-packages.txt"
{{ else -}}
check_apt_packages "$manifests_dir/desktop/apt-packages.txt"
{{ end -}}
check_path "$XDG_CONFIG_HOME/ghostty/config.ghostty" "ghostty config file"
ghostty_bin="$(resolve_ghostty_bin || true)"
check_ghostty_config "$ghostty_bin"
{{ if eq .chezmoi.os "darwin" -}}
check_desktop_font_macos
{{ else -}}
check_desktop_font_fontconfig
{{ end -}}
{{ end }}

if [[ $errors -gt 0 ]]; then
  log_warning "$errors required tool(s) or asset(s) are missing."
  print_diagnostic_hints
  exit 1
fi

log_step "🎉" "All checks passed."

# --- Welcome card ---
log_info "Core tools in this environment:"
print_version_line() {
  local name="$1"
  local output=""

  if [[ "$name" != "ghostty" ]] && ! command -v "$name" >/dev/null 2>&1; then
    return 0
  fi

  case "$name" in
    chezmoi) output="$(chezmoi --version 2>/dev/null | head -1 | awk '{print $3}' | tr -d ',')" ;;
    git)     output="$(git --version 2>/dev/null | awk '{print $3}')" ;;
    mise)    output="$(mise --version 2>/dev/null | awk '{print $1}')" ;;
    ghostty)
      [[ -n "$ghostty_bin" ]] || return 0
      output="$("$ghostty_bin" --version 2>/dev/null | head -1 | awk '{print $2}')"
      ;;
    *)       output="installed" ;;
  esac

  printf '    %-16s %s\n' "$name" "${output:-installed}"
}

# mise prints one `<tool> <version>` line per tool in its current configuration.
print_mise_toolchain() {
  local listing=""
  local tool=""
  local version=""

  listing="$(mise current 2>/dev/null)" || return 0
  while read -r tool version _; do
    if [[ -n "$tool" ]]; then
      printf '    %-16s %s\n' "$tool" "$version"
    fi
  done <<<"$listing"
}

print_version_line chezmoi
print_version_line git
print_version_line mise
print_mise_toolchain
{{ if and $desktopBaseline $isSupportedDesktop -}}
print_version_line ghostty
{{ end }}

log_info "Next steps:"
if rc_file="$(detect_shell_rc_file)"; then
  log_info "  - Reload your shell so this session sees the new PATH (try: source \"$rc_file\")."
else
  log_info "  - Reload your shell (open a new terminal) so PATH picks up the baseline tools."
fi
log_info "  - New to this baseline? Skim docs/01-onboarding.md — five-minute walkthrough of what just ran."
log_info "  - Want machine-only tweaks? Copy starters from docs/local-overlay-examples/ (nothing there is deployed by default)."
log_info "  - Need restricted-network overrides? Keep them local and start from docs/local-overlay-examples/ before the next apply."
log_info "  - Something looks wrong? Open an issue using the repository's bug-report workflow so the report stays structured."

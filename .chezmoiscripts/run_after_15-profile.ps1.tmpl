Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

. {{ includeTemplate "powershell-literal" (joinPath .chezmoi.sourceDir "bootstrap/windows/common.ps1") }}

trap {
    Write-BootstrapFailure -Failure $_
    exit (Get-BootstrapExitCode -Failure $_)
}

if (-not $IsWindows) { throw 'This hook requires native Windows.' }

. {{ includeTemplate "powershell-literal" (joinPath .chezmoi.sourceDir "bootstrap/windows/backup.ps1") }}
. {{ includeTemplate "powershell-literal" (joinPath .chezmoi.sourceDir "bootstrap/windows/profile.ps1") }}
. {{ includeTemplate "powershell-literal" (joinPath .chezmoi.sourceDir "bootstrap/windows/user-path.ps1") }}

$destination = {{ includeTemplate "powershell-literal" .chezmoi.destDir }}
$homeDirectory = {{ includeTemplate "powershell-literal" .chezmoi.homeDir }}
$profilePath = Get-HookProfilePath -Destination $destination -HomeDirectory $homeDirectory
$backupRoot = Get-HookBackupRoot -Destination $destination -HomeDirectory $homeDirectory
$pathTarget = Get-HookUserPathTarget -Destination $destination -HomeDirectory $homeDirectory
Add-ManagedProfileLine -ProfilePath $profilePath -Destination $destination -BackupRoot $backupRoot
if ($pathTarget.RegistryPath -ne 'Environment') {
    Add-ManagedUserPath @pathTarget -Entries @(Get-ManagedProfilePathEntry) -Notify {}
} else {
    Add-ManagedUserPath @pathTarget -Entries @(Get-ManagedProfilePathEntry)
}

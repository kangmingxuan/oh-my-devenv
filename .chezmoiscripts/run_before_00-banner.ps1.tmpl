Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

if (-not $IsWindows) {
    throw 'This hook requires native Windows.'
}
if ($PSVersionTable.PSVersion -lt [version]'7.6') {
    throw "PowerShell 7.6 or later is required. Running $($PSVersionTable.PSVersion). Install PowerShell and ensure pwsh is on PATH."
}

Write-Host "oh-my-devenv for Windows (PowerShell $($PSVersionTable.PSVersion))"
{{ if (index . "desktopBaseline") -}}

. {{ includeTemplate "powershell-literal" (joinPath .chezmoi.sourceDir "bootstrap/windows/common.ps1") }}
. {{ includeTemplate "powershell-literal" (joinPath .chezmoi.sourceDir "bootstrap/windows/desktop.ps1") }}

# Validate the destination before chezmoi writes the Terminal fragment.
Update-HookPath
$null = Get-DesktopLocalData -Destination {{ includeTemplate "powershell-literal" .chezmoi.destDir }}
{{ end -}}

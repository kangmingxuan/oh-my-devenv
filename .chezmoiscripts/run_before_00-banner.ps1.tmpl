Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

if ($PSVersionTable.PSVersion -lt [version]'7.6') {
    throw "PowerShell 7.6 or later is required. Running $($PSVersionTable.PSVersion). Install PowerShell and ensure pwsh is on PATH."
}

Write-Host "oh-my-devenv for Windows (PowerShell $($PSVersionTable.PSVersion))"

{{- $inputs := list
  (include "bootstrap/windows/install-shell-completions.ps1" | sha256sum)
  (include "bootstrap/windows/completions.ps1" | sha256sum)
  (include "dot_config/oh-my-devenv/powershell/completions.ps1" | sha256sum)
  (include "bootstrap/manifests/shell/completions.txt" | sha256sum)
  (include "bootstrap/windows/common.ps1" | sha256sum)
  (include "dot_config/oh-my-devenv/powershell/environment.ps1" | sha256sum)
  (include "bootstrap/manifests/system/winget-packages.json" | sha256sum)
  (include "dot_config/mise/config.toml.tmpl" | sha256sum)
  (include "bootstrap/manifests/ecosystem/go-tools.txt" | sha256sum)
  (include "bootstrap/manifests/ecosystem/uv-tools.txt" | sha256sum) -}}
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

if (-not $IsWindows) { throw 'This hook requires native Windows.' }

& {{ includeTemplate "powershell-literal" (joinPath .chezmoi.sourceDir "bootstrap/windows/install-shell-completions.ps1") }} `
    -Action install -Platform windows `
    -Fingerprint '{{ join "" $inputs | sha256sum }}' `
    -ManifestPath {{ includeTemplate "powershell-literal" (joinPath .chezmoi.sourceDir "bootstrap/manifests/shell/completions.txt") }} `
    -Destination {{ includeTemplate "powershell-literal" .chezmoi.destDir }}

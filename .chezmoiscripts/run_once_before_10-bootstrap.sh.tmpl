{{- $packageManager := includeTemplate "system-package-manager" . -}}
{{ if eq $packageManager "unsupported" -}}
#!/bin/bash
printf 'ERROR: supported systems are macOS, Debian/Ubuntu, and Arch Linux families.\n' >&2
exit 1
{{ else -}}
#!/bin/bash
# Run once on first chezmoi apply to ensure minimal prerequisites.

set -euo pipefail

bootstrap_dir='{{ joinPath .chezmoi.sourceDir "bootstrap" }}'
scripts_dir="$bootstrap_dir/scripts"

source "$scripts_dir/common.sh"
install_error_trap "$0"

log_step "🚀" "Bootstrap: ensuring prerequisites..."

# Copy every pre-existing target of the main and XDG sources to the same
# absolute path beneath a timestamped backup directory before the first apply
# overwrites it. The listing runs the same chezmoi binary as this apply, with
# its own persistent state so it does not wait on the state the apply holds.
backup_existing_managed_configs() {
  local listing_state=""
  local main_paths=""
  local xdg_paths=""
  local existing_path=""
  local backup_dir=""

  listing_state="$(mktemp -d)"
  if ! main_paths="$({{ .chezmoi.executable | quote }} \
    --config={{ .chezmoi.configFile | quote }} \
    --source={{ .chezmoi.sourceDir | quote }} \
    --destination={{ .chezmoi.destDir | quote }} \
    --persistent-state="$listing_state/chezmoistate.boltdb" \
    managed --include=files,symlinks --path-style=absolute --format=)"; then
    rm -rf "$listing_state"
    printf 'ERROR: failed to list managed files for the first-run backup\n' >&2
    exit 1
  fi
  rm -rf "$listing_state"
  xdg_paths="$(bash "$scripts_dir/xdg-config.sh" managed {{ .chezmoi.configFile | quote }})"

  while IFS= read -r existing_path; do
    if [[ -z "$existing_path" || ! -e "$existing_path" ]]; then
      continue
    fi

    if [[ -z "$backup_dir" ]]; then
      backup_dir="$(first_run_backup_root)/$(date -u +%Y%m%dT%H%M%SZ)"
      log_warning "Found pre-existing managed config files. Backing them up before chezmoi overwrites them..."
    fi

    mkdir -p "$backup_dir$(dirname "$existing_path")"
    if ! cp -Lp "$existing_path" "$backup_dir$existing_path"; then
      printf 'ERROR: failed to back up %s to %s (check permissions and available disk space)\n' \
        "$existing_path" "$backup_dir$existing_path" >&2
      exit 1
    fi
    log_info "Backed up $existing_path -> $backup_dir$existing_path"
  done <<<"$main_paths"$'\n'"$xdg_paths"

  if [[ -n "$backup_dir" ]]; then
    log_warning "First-run backup completed. Review $backup_dir after chezmoi finishes if you need to merge any old settings."
  else
    log_info "No pre-existing managed config files detected."
  fi
}

backup_existing_managed_configs

{{ if eq $packageManager "pacman" -}}
if ! command -v curl >/dev/null 2>&1 || ! command -v git >/dev/null 2>&1; then
  require_sudo "install essential prerequisites via pacman"
  sudo pacman -S --needed --noconfirm git curl
fi
{{- else if eq $packageManager "apt" -}}
if ! command -v curl >/dev/null 2>&1 || ! command -v git >/dev/null 2>&1; then
  log_step "📦" "Installing essential prerequisites via apt..."
  require_sudo "install essential prerequisites via apt"
  sudo env DEBIAN_FRONTEND=noninteractive apt-get update -qq
  sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends git curl
fi
{{- else if eq .chezmoi.os "darwin" -}}
# Ensure Homebrew is installed.
if ! command -v brew >/dev/null 2>&1 \
  && [[ ! -x /opt/homebrew/bin/brew ]] \
  && [[ ! -x /usr/local/bin/brew ]]; then
  log_step "🍺" "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

if ! command -v brew >/dev/null 2>&1 \
  && [[ ! -x /opt/homebrew/bin/brew ]] \
  && [[ ! -x /usr/local/bin/brew ]]; then
  echo "ERROR: Homebrew installation finished but brew was not found" >&2
  exit 1
fi
{{- end }}

# Ensure ~/.local/bin exists for tools installed outside the system package manager.
mkdir -p "$HOME/.local/bin"

log_step "✅" "Bootstrap prerequisites ready."
{{ end -}}

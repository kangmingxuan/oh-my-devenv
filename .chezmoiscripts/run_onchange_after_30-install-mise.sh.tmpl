#!/bin/bash
{{ includeTemplate "common-bootstrap-hashes" . }}
set -euo pipefail

bootstrap_dir='{{ joinPath .chezmoi.sourceDir "bootstrap" }}'
scripts_dir="$bootstrap_dir/scripts"

source "$scripts_dir/common.sh"
install_error_trap "$0"

{{ if eq .chezmoi.os "darwin" -}}
BREW_CMD="$(brew_command)"
eval "$("$BREW_CMD" shellenv)"
{{ else -}}
export PATH="$HOME/.local/bin:$PATH"
{{ end -}}

log_phase "Setting up mise..."
if command -v mise >/dev/null 2>&1; then
  log_skip "mise is already installed."
else
  log_info "Installing mise..."
{{ if eq .chezmoi.os "darwin" -}}
  "$BREW_CMD" install mise
{{ else -}}
  curl -fsSL "${DOTFILES_MISE_INSTALL_URL:-https://mise.run}" | sh
{{ end -}}
fi

mise_version="$(capture_probe mise --version)" || {
  probe_status=$?
  _bootstrap_error_handler "$probe_status" "$LINENO" "$0" "$mise_version"
  exit "$probe_status"
}
log_ok mise "$mise_version"
log_phase_done
